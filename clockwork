def export_data(provider, idle_threshold, since, until, detail, anonymize,
                show_tokens=False):
    """Emit one versioned JSON bundle of every project for external tools.

    Always writes JSON to stdout. `detail` selects granularity:
      daily    → per-day minutes/prompts only (smallest, least revealing)
      sessions → adds grouped sessions with start/end + prompt counts
      raw      → adds every prompt's epoch-second timestamp (fully re-analyzable)

    Higher levels are supersets: a `raw` export still carries the daily and
    session aggregates so a consumer can start simple and drill down.
    Timestamps are UTC-based epoch seconds; the `daily` buckets use UTC dates.

    Provider attribution lives at the project level: every entry carries a
    `provider`, and a `both` export emits one entry per (path, provider) pair
    so a path touched by both tools appears twice — each with its own totals,
    daily, sessions, and prompts. Top-level `provider` is "both" when more than
    one provider contributed; `providers` lists them, and `totals.by_provider`
    breaks the grand totals down per provider.

    With `show_tokens`, every project, day, provider and the grand totals also
    carry a normalized `tokens` record with a per-model breakdown. The token
    fields are purely additive — a v2 consumer reads a v3 bundle unchanged.
    """
    out_projects = []
    by_provider = {}
    grand_minutes = 0.0
    grand_prompts = 0
    grand_sessions = 0
    grand_events = []
    name_counter = 0

    for prov in _export_providers(provider):
        if show_tokens:
            projects = PROVIDERS[prov]["scan"]()
        else:
            projects = [(label, ts, []) for label, ts in PROVIDERS[prov]["all"]()]
        p_minutes = 0.0
        p_prompts = 0
        p_sessions = 0
        p_projects = 0
        p_events = []

        for label, timestamps, events in sorted(projects, key=lambda p: p[0]):
            timestamps = _filter_timestamps(timestamps, since, until)
            if not timestamps:
                continue
            events = _filter_events(events, since, until)
            daily, _ = compute_active_hours(timestamps, idle_threshold)
            sessions = group_sessions(timestamps, idle_threshold)
            total_minutes = sum(daily.values())

            prompts_per_day = defaultdict(int)
            for ts in timestamps:
                prompts_per_day[ts.date()] += 1

            token_days = tokens_by_day(events) if show_tokens else {}

            name_counter += 1
            proj = {
                "id": _project_id(prov, label),
                "provider": prov,
                "name": f"project-{name_counter}" if anonymize else _display_name(label),
                "totals": {
                    "minutes": round(total_minutes, 2),
                    "prompts": len(timestamps),
                    "sessions": len(sessions),
                    "active_days": len(daily),
                    "first": int(timestamps[0].timestamp()),
                    "last": int(timestamps[-1].timestamp()),
                },
                "daily": [
                    _day_entry(day, daily, prompts_per_day, token_days, show_tokens)
                    for day in _day_keys(daily, token_days)
                ],
            }
            if show_tokens:
                proj["tokens"] = summarize_tokens(events)
            if not anonymize:
                proj["path"] = label
            if detail in ("sessions", "raw"):
                proj["sessions"] = [
                    {"start": int(s.timestamp()),
                     "end": int(e.timestamp()),
                     "minutes": round((e - s).total_seconds() / 60, 2),
                     "prompts": c}
                    for s, e, c in sessions
                ]
            if detail == "raw":
                proj["prompts"] = [int(ts.timestamp()) for ts in timestamps]

            out_projects.append(proj)
            p_projects += 1
            p_minutes += total_minutes
            p_prompts += len(timestamps)
            p_sessions += len(sessions)
            p_events.extend(events)

        if p_projects:
            by_provider[prov] = {
                "projects": p_projects,
                "minutes": round(p_minutes, 2),
                "prompts": p_prompts,
                "sessions": p_sessions,
            }
            if show_tokens:
                by_provider[prov]["tokens"] = summarize_tokens(p_events)
            grand_minutes += p_minutes
            grand_prompts += p_prompts
            grand_sessions += p_sessions
            grand_events.extend(p_events)

    # Report the providers that actually contributed activity; fall back to the
    # requested set so a single-provider export is never emitted with an empty
    # `providers` list even when nothing matched the filters.
    present = sorted(by_provider)
    providers = present if present else sorted(_export_providers(provider))
    provider_field = "both" if len(providers) > 1 else providers[0]

    grand_tokens = summarize_tokens(grand_events) if show_tokens else None
    totals = {
        "projects": len(out_projects),
        "minutes": round(grand_minutes, 2),
        "prompts": grand_prompts,
        "sessions": grand_sessions,
        "by_provider": by_provider,
    }
    if show_tokens:
        totals["tokens"] = grand_tokens

    _print_json({
        "schema": "clockwork/v3",
        "generated_at": datetime.now().astimezone().isoformat(),
        "provider": provider_field,
        "providers": providers,
        "idle_threshold_min": idle_threshold,
        "detail": detail,
        "anonymized": anonymize,
        "tokens": show_tokens,
        "daily_tz": "UTC",
        "since": _iso(since),
        "until": _iso(until),
        "projects": out_projects,
        "totals": totals,
    })

    # A friendly receipt on stderr — keeps stdout pure JSON for redirection.
    dest = _stdout_target()
    where = dest if dest else "stdout"
    tags = [provider_field, f"detail={detail}"]
    if anonymize:
        tags.append("anonymized")
    if show_tokens:
        tags.append("tokens")
    print(f"\n  ✓ export complete → {where}", file=sys.stderr)
    print(f"    {' · '.join(tags)}", file=sys.stderr)
    print(f"    {len(out_projects)} projects · {grand_prompts:,} prompts "
          f"· {grand_sessions:,} sessions · {grand_minutes / 60:.1f}h active",
          file=sys.stderr)
    if show_tokens:
        print(f"    {grand_tokens['total']:,} tokens · "
              f"{grand_tokens['responses']:,} responses · "
              f"{len(grand_tokens['by_model'])} model(s)", file=sys.stderr)


def list_projects(provider, as_json):
    projects = PROVIDERS[provider]["list"]()
    if as_json:
        _print_json({
            "provider": provider,
            "location": PROVIDERS[provider]["location"],
            "projects": projects,
        })
        sys.exit(0 if projects else 1)
    if not projects:
        print(f"❌ No {provider} projects found ({PROVIDERS[provider]['location']})")
        sys.exit(1)
    print(f"📁 {len(projects)} {provider} project(s) ({PROVIDERS[provider]['location']}):\n")
    for p in projects:
        print(f"   {p}")
    print()


def _die(msg):
    print(f"clockwork: {msg}", file=sys.stderr)
    sys.exit(2)


def _parse_args(argv):
    """Split flags from positionals. Returns (positionals, opts)."""
    opts = {"json": False, "since": None, "until": None,
            "detail": "raw", "anonymize": False, "tokens": False}
    positionals = []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--json":
            opts["json"] = True
        elif a == "--anonymize":
            opts["anonymize"] = True
        elif a == "--tokens":
            opts["tokens"] = True
        elif a in ("--since", "--until", "--detail"):
            i += 1
            if i >= len(argv):
                _die(f"{a} requires a value")
            opts[a[2:]] = argv[i]
        elif a.startswith("--since="):
            opts["since"] = a.split("=", 1)[1]
        elif a.startswith("--until="):
            opts["until"] = a.split("=", 1)[1]
        elif a.startswith("--detail="):
            opts["detail"] = a.split("=", 1)[1]
        elif a.startswith("--"):
            _die(f"unknown option: {a}")
        else:
            positionals.append(a)
        i += 1
    return positionals, opts


def _force_utf8_streams():
    """Write UTF-8 on stdout/stderr regardless of the platform locale.

    Windows falls back to the locale codepage (usually cp1252) whenever output
    is redirected to a file or pipe, and the bar glyph and status marks used
    below are not encodable there. Reconfiguring keeps output byte-identical
    across platforms; the JSON export is pure ASCII either way.
    """
    for stream in (sys.stdout, sys.stderr):
        try:
            stream.reconfigure(encoding="utf-8")
        except (AttributeError, ValueError):
            # Detached or replaced streams (test capture, some launchers) have
            # nothing to reconfigure; whatever encoding they carry stands.
            pass


def main():
    _force_utf8_streams()
    argv = sys.argv[1:]
    if "-h" in argv or "--help" in argv:
        print(__doc__.strip())
        sys.exit(0)
    positionals, opts = _parse_args(argv)
    if len(positionals) < 2:
        print(__doc__.strip())
        sys.exit(1)

    provider = positionals[0].lower()
    if provider not in PROVIDERS:
        print(f"Unknown provider: {positionals[0]!r} (expected 'claude', 'codex', or 'both')\n")
        print(__doc__.strip())
        sys.exit(1)

    target = positionals[1]
    idle_threshold = int(positionals[2]) if len(positionals) > 2 else 30

    if opts["detail"] not in ("raw", "sessions", "daily"):
        _die(f"--detail must be raw, sessions, or daily (got {opts['detail']!r})")

    try:
        since = _parse_date_bound(opts["since"])
        until = _parse_date_bound(opts["until"], end_of_day=True)
    except ValueError as e:
        _die(str(e))

    if target == "all":
        analyze_all(provider, idle_threshold, since, until, opts["json"],
                    opts["tokens"])
    elif target in ("today", "week"):
        analyze_summary(provider, target, idle_threshold, opts["json"],
                        opts["tokens"])
    elif target == "export":
        export_data(provider, idle_threshold, since, until,
                    opts["detail"], opts["anonymize"], opts["tokens"])
    elif target == "list":
        list_projects(provider, opts["json"])
    else:
        analyze_single(provider, target, idle_threshold, since, until,
                       opts["json"], opts["tokens"])


if __name__ == "__main__":
    main()
