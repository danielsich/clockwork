# `scan`/`scan_single` are the token-aware backends: same work as `all`/`single`
# plus the usage records picked up in the same pass. `all`/`single` remain the
# timing-only views, and are what the plain (no --tokens) commands read.
PROVIDERS = {
    "claude": {
        "single": claude_single,
        "scan_single": claude_scan_single,
        "all": claude_all,
        "scan": claude_scan,
        "list": claude_list,
        "location": "~/.claude/projects/",
    },
    "codex": {
        "single": codex_single,
        "scan_single": codex_scan_single,
        "all": codex_all,
        "scan": codex_scan,
        "list": codex_list,
        "location": "$CODEX_HOME/sessions/",
    },
    "both": {
        "single": both_single,
        "scan_single": both_scan_single,
        "all": both_all,
        "scan": both_scan,
        "list": both_list,
        "location": "claude + codex",
    },
}


def _provider_label(provider):
    """Human display name for headers ('both' reads better spelled out)."""
    return "CLAUDE + CODEX" if provider == "both" else provider.upper()


def _export_providers(provider):
    """Concrete single-provider backends to walk for an export.

    `both` fans out to each real provider so a project's activity can be
    attributed per provider; a single provider exports just itself.
    """
    return ["claude", "codex"] if provider == "both" else [provider]


