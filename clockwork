    grand_tokens = summarize_tokens(all_events) if show_tokens else None

    if as_json:
        projects_json = []
        for r in rows:
            entry = {"project": r["label"],
                     "minutes": round(r["minutes"], 2),
                     "prompts": r["prompts"],
                     "sessions": r["sessions"]}
            if show_tokens:
                entry["tokens"] = r["tokens"]
            projects_json.append(entry)
        totals = {
            "projects": len(rows),
            "minutes": round(grand_minutes, 2),
            "prompts": grand_prompts,
            "sessions": grand_sessions,
        }
        if show_tokens:
            totals["tokens"] = grand_tokens
        _print_json({
            "provider": provider,
            "idle_threshold_min": idle_threshold,
            "since": _iso(since),
            "until": _iso(until),
