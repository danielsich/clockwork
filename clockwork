#!/usr/bin/env python3
"""
clockwork — analyze Claude Code / Codex session activity.

Usage:
  clockwork <provider> <project-path> [idle-min] [options]  Analyze one project
  clockwork <provider> all [idle-min] [options]             Rank all projects
  clockwork <provider> today [idle-min] [options]           Today, all projects
  clockwork <provider> week [idle-min] [options]            Last 7 days, all projects
  clockwork <provider> export [idle-min] [options]          Bundle all projects as JSON
  clockwork <provider> list [options]                       List project folders

  <provider> is one of: claude | codex | both

  both merges Claude and Codex activity per project, so every command above
  works across both tools at once.

  today / week use your local day boundaries and aggregate every project into
  one summary — the "how much have I done" daily check-in. export writes a
  single self-describing JSON bundle for uploading to external tools.

Options:
  --json            Emit machine-readable JSON instead of ASCII tables
  --since <when>    Only count prompts on/after this point in time
  --until <when>    Only count prompts on/before this point in time
                    <when> is YYYY-MM-DD, an ISO timestamp, or a relative
                    form like 7d (7 days ago) or 2w (2 weeks ago)
  --detail <level>  export granularity: raw | sessions | daily (default raw)
  --anonymize       export: replace project paths with a hash id + generic name
  --tokens          Also report token usage and a per-model breakdown

Examples:
  clockwork claude ~/code/myproject
  clockwork codex ~/code/myproject 45
  clockwork codex all --json
  clockwork claude today
  clockwork codex week --json
  clockwork both all
  clockwork both today
  clockwork claude export > clockwork.json
  clockwork codex export --detail sessions --anonymize > share.json
  clockwork both today --tokens
  clockwork claude all --tokens --since 7d
  clockwork both export --tokens > clockwork.json
  clockwork claude all --since 7d
  clockwork claude ~/code/myproject --since 2026-07-01 --until 2026-07-05
  clockwork claude list

Data sources:
  claude → ~/.claude/projects/<encoded-path>/*.jsonl
  codex  → $CODEX_HOME/sessions/**/rollout-*.jsonl   (default ~/.codex/sessions)

Token usage (--tokens):
  Both tools log per-response usage, counted differently, so clockwork
  normalizes them before summing:

  claude → `assistant` records carry message.model + message.usage. One API
           response spans several lines (thinking, text, each tool_use), each
           repeating its usage block, so responses are deduplicated on
           message id, keeping the final (largest) count per field.
           Subagent logs (<session>/subagents/*.jsonl) are included. Cache
           reads/writes sit outside input_tokens.
  codex  → `event_msg -> token_count` records carry a cumulative
           total_token_usage; per-turn cost is read as the rise in that counter
           because last_token_usage is re-emitted on aborted turns. The model
           comes from the preceding `turn_context`, and cached_input_tokens is
           subtracted out of input_tokens to match Claude's split.
"""

import sys
import json
import os
import re
import glob
import hashlib
from datetime import datetime, timedelta, timezone
from collections import defaultdict

def _resolve_claude_dir():
    if sys.platform == "win32":
        appdata = os.environ.get("APPDATA")
        if appdata:
            candidate = os.path.join(appdata, "Claude", "projects")
            if os.path.isdir(candidate):
                return candidate
        return os.path.join(os.path.expanduser("~"), ".claude", "projects")
    return os.path.expanduser("~/.claude/projects")

CLAUDE_DIR = _resolve_claude_dir()


# --------------------------------------------------------------------------- #
# Shared timing logic
# --------------------------------------------------------------------------- #

def group_sessions(timestamps, idle_threshold_minutes=30):
    """Group sorted prompt timestamps into (start, end, prompt_count) sessions.

    A gap larger than the idle threshold starts a new session.
    """
    if not timestamps:
        return []
    threshold = timedelta(minutes=idle_threshold_minutes)
    sessions = []
    start = end = timestamps[0]
    count = 1
    for ts in timestamps[1:]:
        if ts - end > threshold:
            sessions.append((start, end, count))
            start = ts
            count = 0
        end = ts
        count += 1
    sessions.append((start, end, count))
    return sessions


def compute_active_hours(timestamps, idle_threshold_minutes=30):
    """Return (per-day active minutes, [(start, end), ...] sessions).

    Session duration is split across calendar-day boundaries so a session
    crossing midnight is credited to each day it actually spans.
    """
    sessions = group_sessions(timestamps, idle_threshold_minutes)
    daily = defaultdict(float)
    for start, end, _ in sessions:
        _add_session_to_daily(daily, start, end)
    return daily, [(start, end) for start, end, _ in sessions]


def _add_session_to_daily(daily, start, end):
    """Distribute a session's minutes across the calendar days it spans."""
    total_min = (end - start).total_seconds() / 60
    if total_min < 1:
        # Zero-length (or sub-minute) session: floor at 1 minute on its day.
        daily[start.date()] += 1
        return
    cursor = start
    while cursor < end:
        next_midnight = datetime.combine(
            cursor.date() + timedelta(days=1),
            datetime.min.time(),
            tzinfo=cursor.tzinfo,
        )
        seg_end = min(end, next_midnight)
        daily[cursor.date()] += (seg_end - cursor).total_seconds() / 60
        cursor = seg_end


# --------------------------------------------------------------------------- #
# Token accounting
# --------------------------------------------------------------------------- #
#
# Both providers log per-response token usage, but they count it differently,
# so every backend normalizes into one record shape before anything is summed:
#
#   input        fresh (uncached) input tokens
#   output       output tokens, thinking/reasoning included
#   cache_read   input served from cache
#   cache_write  input written to cache   (Claude only; Codex never reports it)
#   reasoning    thinking tokens, a SUBSET of output (Codex only; Claude folds
#                thinking into output without breaking it out)
#
# Claude reports cache reads and writes outside `input_tokens`; Codex reports
# `cached_input_tokens` *inside* `input_tokens`, so the Codex reader subtracts
# it back out. After that, total = input + output + cache_read + cache_write
# holds for both, and `reasoning` is deliberately left out of it to avoid
# double counting the part of output it already covers.

TOKEN_FIELDS = ("input", "output", "cache_read", "cache_write", "reasoning")


def _new_token_rec():
    rec = {"responses": 0}
    rec.update({f: 0 for f in TOKEN_FIELDS})
    return rec


def _accumulate_tokens(rec, event):
    rec["responses"] += 1
    for f in TOKEN_FIELDS:
        rec[f] += event[f]


def _sealed(rec):
    """Copy a running record with its derived `total` filled in."""
    out = dict(rec)
    out["total"] = rec["input"] + rec["output"] + rec["cache_read"] + rec["cache_write"]
    return out


def summarize_tokens(events):
    """Aggregate token events into overall totals plus a per-model breakdown."""
    overall = _new_token_rec()
    per_model = defaultdict(_new_token_rec)
    for event in events:
        _accumulate_tokens(overall, event)
        _accumulate_tokens(per_model[event["model"] or "unknown"], event)
    summary = _sealed(overall)
    models = []
    for model, rec in per_model.items():
        entry = {"model": model}
        entry.update(_sealed(rec))
        models.append(entry)
    # Biggest consumer first, name as the tie-break so output is deterministic.
    models.sort(key=lambda m: (-m["total"], m["model"]))
    summary["by_model"] = models
    return summary


def tokens_by_day(events):
    """Bucket token events into per-day (UTC) sealed records."""
    daily = defaultdict(_new_token_rec)
    for event in events:
        _accumulate_tokens(daily[event["ts"].date()], event)
    return {day: _sealed(rec) for day, rec in daily.items()}


def _filter_events(events, since, until):
    if since is None and until is None:
        return events
    return [
        e for e in events
        if (since is None or e["ts"] >= since) and (until is None or e["ts"] <= until)
    ]


def fmt_tokens(n):
    """Compact token count for table cells (1_234_567 -> '1.2M')."""
    for cutoff, suffix in ((1e9, "B"), (1e6, "M"), (1e3, "k")):
        if n >= cutoff:
            return f"{n / cutoff:.1f}{suffix}"
    return str(int(n))


def fmt_duration(minutes):
    h = int(minutes) // 60
    m = int(minutes) % 60
    if h > 0:
        return f"{h}h {m:02d}m"
    return f"{m}m"


def _parse_ts(value):
    if not value:
        return None
    try:
        dt = datetime.fromisoformat(value.replace("Z", "+00:00"))
    except (ValueError, TypeError, AttributeError):
        return None
    # Normalize everything to UTC-aware so timestamps from mixed sources
    # (some tz-aware, some naive) can be safely sorted and subtracted.
    if dt.tzinfo is None:
        return dt.replace(tzinfo=timezone.utc)
    return dt.astimezone(timezone.utc)


def _parse_date_bound(value, end_of_day=False):
    """Parse a --since/--until value into a UTC-aware datetime.

    Accepts a relative form (`7d`, `2w`) meaning that many days/weeks before
    now, a bare ISO date (`YYYY-MM-DD`), or a full ISO timestamp. A bare date
    used as an upper bound snaps to the end of that day so the day is inclusive.
    """
    if not value:
        return None
    value = value.strip()
    m = re.fullmatch(r"(\d+)([dw])", value.lower())
    if m:
        n = int(m.group(1))
        delta = timedelta(weeks=n) if m.group(2) == "w" else timedelta(days=n)
        return datetime.now(timezone.utc) - delta
    try:
        dt = datetime.strptime(value, "%Y-%m-%d").replace(tzinfo=timezone.utc)
        if end_of_day:
            dt = dt.replace(hour=23, minute=59, second=59, microsecond=999999)
        return dt
    except ValueError:
        pass
    dt = _parse_ts(value)
    if dt is None:
        raise ValueError(
            f"unrecognized date {value!r} (use YYYY-MM-DD, an ISO timestamp, "
            f"or a relative form like 7d / 2w)"
        )
    return dt


def _filter_timestamps(timestamps, since, until):
    """Keep only timestamps within [since, until] (either bound may be None)."""
    if since is None and until is None:
        return timestamps
    return [
        ts for ts in timestamps
        if (since is None or ts >= since) and (until is None or ts <= until)
    ]


def _iso(dt):
    return dt.isoformat() if dt else None


def _print_json(obj):
    print(json.dumps(obj, indent=2))


def _stdout_target():
    """Best-effort name of where stdout is going, for status messages.

    Returns the basename of the file when stdout is redirected to a regular
    file (`> out.json`), or None for a terminal or a pipe. Purely cosmetic;
    any failure degrades to None so it never affects the export itself.
    """
    try:
        if os.isatty(1):
            return None
    except Exception:
        return None
    path = None
    try:  # macOS / BSD: ask the kernel for fd 1's path
        import fcntl
        f_getpath = getattr(fcntl, "F_GETPATH", 50)
        raw = fcntl.fcntl(1, f_getpath, b"\0" * 1024)
        path = raw.split(b"\0", 1)[0].decode() or None
    except Exception:
        try:  # Linux: /proc symlink
            path = os.readlink("/proc/self/fd/1")
        except Exception:
            path = None
    if path and os.path.isfile(path):
        return os.path.basename(path)
    return None


def _project_id(provider, path):
    """Stable short id for a (provider, path) pair (survives anonymization).

    Hashing the provider alongside the path keeps ids distinct when the same
    project is touched by more than one tool, so a combined export can carry
    two entries for one path without id collisions.
    """
    return hashlib.sha1(f"{provider}\0{path}".encode("utf-8")).hexdigest()[:8]


def _display_name(path):
    return os.path.basename(path.rstrip("/\\")) or path


# --------------------------------------------------------------------------- #
# Claude backend  (~/.claude/projects/<encoded-path>/*.jsonl)
# --------------------------------------------------------------------------- #

def _claude_encode_path(path):
    """Encode a path the way Claude Code names its per-project log folder.

    Every character that is not an ASCII letter or digit becomes `-`, so
    `/a/team-5/My Drive` and `/a/team/5/My-Drive` both encode to
    `-a-team-5-My-Drive`. That makes the encoding lossy; see
    `_claude_folder_cwd` for recovering the real path.
    """
    return re.sub(r"[^A-Za-z0-9]", "-", path)


def path_to_claude_folder(project_path):
    abs_path = os.path.abspath(os.path.expanduser(project_path))
    folder_name = _claude_encode_path(abs_path)
    if folder_name.startswith("-"):
        folder_name = folder_name[1:]
    return folder_name


def _claude_session_files(folder_dir):
    """Return ([session logs], [subagent logs]) for one Claude project folder.

    Subagent transcripts are not part of the session log: Claude Code writes
    them beside it, under `<session-id>/subagents/agent-*.jsonl`.
    """
    sessions = glob.glob(os.path.join(folder_dir, "*.jsonl"))
    subagents = glob.glob(os.path.join(folder_dir, "*", "subagents", "*.jsonl"))
    return sessions, subagents


def _claude_resolve_files(project_path):
    """Return (folder_name, [session logs], [subagent logs]) for a project
    path, or (None, [], [])."""
    folder = path_to_claude_folder(project_path)
    # Claude Code retains the leading dash from the absolute path, so try both
    # the dash-prefixed and stripped forms to match whichever convention exists.
    for candidate in ("-" + folder, folder):
        files, subagents = _claude_session_files(os.path.join(CLAUDE_DIR, candidate))
        if files:
            return candidate, files, subagents
    return None, [], []


_CLAUDE_USAGE_FIELDS = (
    ("input", "input_tokens"),
    ("output", "output_tokens"),
    ("cache_read", "cache_read_input_tokens"),
    ("cache_write", "cache_creation_input_tokens"),
)


def _claude_token_event(record, dt, seen):
    """Normalize one Claude assistant record into a token event, or None.

    Claude Code writes one line per content block — thinking, text, and each
    tool_use — and every line repeats the usage of the whole API response.
    Counting per line inflates totals roughly 2.6x, so responses are
    deduplicated on the message id (falling back to the request id).

    The repeated usage is not always identical: subagent logs write the first
    line while the response is still streaming (`output_tokens: 3`) and only
    the last line carries the final count. So a repeat is folded into the
    event already recorded, keeping the larger value per field. Main-thread
    lines are identical, so for them this is the same as keeping the first.
    `seen` maps each key to the event recorded for it.
    """
    message = record.get("message") or {}
    usage = message.get("usage")
    model = message.get("model")
    # `<synthetic>` marks locally generated messages (errors, interrupts);
    # they carry a zero usage block and never hit the API.
    if not usage or not model or model == "<synthetic>" or dt is None:
        return None
    event = {"ts": dt, "model": model}
    for field, usage_key in _CLAUDE_USAGE_FIELDS:
        event[field] = usage.get(usage_key) or 0
    event["reasoning"] = 0  # Claude folds thinking into output_tokens
    key = message.get("id") or record.get("requestId")
    if key is not None:
        prior = seen.get(key)
        if prior is not None:
            for field, _ in _CLAUDE_USAGE_FIELDS:
                prior[field] = max(prior[field], event[field])
            return None
        seen[key] = event
    return event


def _claude_scan_files(files, subagent_files=()):
    """Return (prompt timestamps, token events) from Claude .jsonl files.

    Both come out of a single pass: the files are already read end to end for
    the timestamps, so picking up usage costs nothing extra. The dedup map is
    shared across the whole file list so a response replayed into a resumed
    session's log is still only counted once.

    `subagent_files` contribute token events only. Their user-role records are
    the parent's task prompt plus tool results, none of it typed by a person,
    so adding them to the timestamps would inflate `prompts` further (see
    ROADMAP §1, which is where subagent activity belongs).
    """
    timestamps = []
    events = []
    seen = {}
    sources = [(f, True) for f in sorted(files)]
    sources += [(f, False) for f in sorted(subagent_files)]
    for f, count_prompts in sources:
        with open(f, encoding="utf-8") as fh:
            for line in fh:
                line = line.strip()
                if not line:
                    continue
                try:
                    d = json.loads(line)
                except json.JSONDecodeError:
                    continue
                role = d.get("role") or d.get("type", "")
                dt = _parse_ts(d.get("timestamp"))
                if dt and role in ("human", "user"):
                    if count_prompts:
                        timestamps.append(dt)
                elif role == "assistant":
                    event = _claude_token_event(d, dt, seen)
                    if event:
                        events.append(event)
    return sorted(timestamps), events


def _claude_timestamps_from_files(files):
    """Parse user/human turn timestamps from Claude .jsonl files."""
    return _claude_scan_files(files)[0]


def _claude_folder_to_pretty(folder):
    """Best-effort readable path from a Claude folder name (display only)."""
    if sys.platform == "win32":
        return folder
    return "/" + folder.lstrip("-").replace("-", "/")


def _claude_folder_cwd(folder, files):
    """The project's real path, read from the `cwd` its records carry.

    The folder name can't be decoded reliably (`team-5` and `team/5` encode
    alike), and a wrong decode both mislabels the project and stops `both`
    from merging it with the Codex rollouts for the same path. Every Claude
    record carries `cwd`, so take the first one that encodes back to this
    folder's name. The check matters because a session that `cd`s elsewhere
    records the new cwd. Falls back to the decoded name if nothing matches.
    """
    for f in sorted(files):
        try:
            with open(f, encoding="utf-8") as fh:
                for line in fh:
                    if '"cwd"' not in line:
                        continue
                    try:
                        cwd = json.loads(line).get("cwd")
                    except (json.JSONDecodeError, AttributeError):
                        continue
                    if cwd and _claude_encode_path(cwd) == folder:
                        return cwd
        except OSError:
            continue
    return _claude_folder_to_pretty(folder)


def claude_scan_single(project_path):
    folder, files, subagents = _claude_resolve_files(project_path)
    if not files:
        return None, 0, [], []
    ts, events = _claude_scan_files(files, subagents)
    return folder, len(files), ts, events


def claude_single(project_path):
    folder, count, ts, _ = claude_scan_single(project_path)
    return folder, count, ts


def claude_scan():
    result = []
    for folder in _claude_list_folders():
        files, subagents = _claude_session_files(os.path.join(CLAUDE_DIR, folder))
        ts, events = _claude_scan_files(files, subagents)
        if ts:
            result.append((_claude_folder_cwd(folder, files), ts, events))
    return result


def claude_all():
    return [(label, ts) for label, ts, _ in claude_scan()]


def _claude_list_folders():
    if not os.path.exists(CLAUDE_DIR):
        return []
    # Skip stray files such as macOS's .DS_Store; only folders hold logs.
    return sorted(name for name in os.listdir(CLAUDE_DIR)
                  if os.path.isdir(os.path.join(CLAUDE_DIR, name)))


def claude_list():
    return _claude_list_folders()


# --------------------------------------------------------------------------- #
# Codex backend  ($CODEX_HOME/sessions/**/rollout-*.jsonl)
# --------------------------------------------------------------------------- #

def _codex_files():
    codex_home = os.environ.get("CODEX_HOME", os.path.expanduser("~/.codex"))
    pattern = os.path.join(codex_home, "sessions", "**", "rollout-*.jsonl")
    return glob.glob(pattern, recursive=True)


_CODEX_TOKEN_KEYS = ("input_tokens", "cached_input_tokens",
                     "output_tokens", "reasoning_output_tokens")


def _codex_token_event(record, payload, running, model):
    """Normalize one Codex `token_count` record into a token event, or None.

    Codex reports both a per-turn `last_token_usage` and a cumulative
    `total_token_usage`, and the per-turn number cannot be trusted on its own:
    aborted and no-op turns re-emit a stale `last_token_usage` that the
    cumulative counter never absorbs, so summing it overstates usage (by up to
    20% in a single session). The turn's real cost is the rise in the
    cumulative counter, which is monotonic within a rollout and restarts at
    zero in forked/resumed sessions — so no cross-file double counting either.
    """
    info = payload.get("info") or {}
    total = info.get("total_token_usage") or {}
    delta = {}
    for k in _CODEX_TOKEN_KEYS:
        value = total.get(k) or 0
        delta[k] = max(0, value - running[k])
        running[k] = value
    if not any(delta.values()):
        return None
    dt = _parse_ts(record.get("timestamp") or payload.get("timestamp"))
    if dt is None:
        return None
    cached = delta["cached_input_tokens"]
    return {
        "ts": dt,
        "model": model,
        # Codex counts cache reads inside input_tokens; split them back out so
        # the number means the same thing it does on the Claude side.
        "input": max(0, delta["input_tokens"] - cached),
        "output": delta["output_tokens"],
        "cache_read": cached,
        "cache_write": 0,  # not reported by Codex
        "reasoning": delta["reasoning_output_tokens"],
    }


def _codex_scan_file(path):
    """Return (cwd, [timestamps], [token events]) for one rollout file.

    Prompts come from the first of these sources that the file contains, so
    the same input is never counted twice:

      1. `event_msg -> user_message`, the canonical record in older rollouts
      2. `event_msg -> item_completed` with a `UserMessage` item, which
         replaced it in newer rollouts
      3. `response_item` user-role messages, as a last resort. These also
         carry injected context (environment, AGENTS.md), so they overcount.

    The model is not in `session_meta` (which only names the provider) — it
    rides on `turn_context`, so each turn is attributed to the most recent one.
    """
    cwd = None
    canonical = []
    items = []
    fallback = []
    events = []
    model = None
    first_model = None
    running = {k: 0 for k in _CODEX_TOKEN_KEYS}
    try:
        with open(path, encoding="utf-8") as fh:
            for line in fh:
                line = line.strip()
                if not line:
                    continue
                try:
                    d = json.loads(line)
                except json.JSONDecodeError:
                    continue
                t = d.get("type")
                payload = d.get("payload") or {}
                if t == "session_meta":
                    cwd = payload.get("cwd")
                elif t == "turn_context":
                    model = payload.get("model") or model
                    if first_model is None:
                        first_model = model
                elif t == "event_msg" and payload.get("type") == "user_message":
                    dt = _parse_ts(d.get("timestamp") or payload.get("timestamp"))
                    if dt:
                        canonical.append(dt)
                elif (t == "event_msg"
                      and payload.get("type") == "item_completed"
                      and (payload.get("item") or {}).get("type") == "UserMessage"):
                    dt = _parse_ts(d.get("timestamp"))
                    if dt:
                        items.append(dt)
                elif t == "event_msg" and payload.get("type") == "token_count":
                    event = _codex_token_event(d, payload, running, model)
                    if event:
                        events.append(event)
                elif (t == "response_item"
                      and payload.get("type") == "message"
                      and payload.get("role") == "user"):
                    dt = _parse_ts(d.get("timestamp") or payload.get("timestamp"))
                    if dt:
                        fallback.append(dt)
    except OSError:
        return None, [], []
    # A few turns are logged before the first `turn_context`; credit them to
    # the model the session went on to use rather than losing them to unknown.
    if first_model:
        for event in events:
            if event["model"] is None:
                event["model"] = first_model
    prompts = canonical or items or fallback
    return cwd, sorted(prompts), events


def _codex_parse_file(path):
    """Return (cwd, [timestamps]) for one rollout file."""
    cwd, timestamps, _ = _codex_scan_file(path)
    return cwd, timestamps


def codex_scan_single(project_path):
    abs_path = os.path.abspath(os.path.expanduser(project_path))
    matched = 0
    timestamps = []
    events = []
    for f in _codex_files():
        cwd, file_ts, file_events = _codex_scan_file(f)
        if cwd == abs_path:
            matched += 1
            timestamps.extend(file_ts)
            events.extend(file_events)
    if not matched:
        return None, 0, [], []
    return abs_path, matched, sorted(timestamps), events


def codex_single(project_path):
    label, count, ts, _ = codex_scan_single(project_path)
    return label, count, ts


def codex_scan():
    ts_groups = defaultdict(list)
    event_groups = defaultdict(list)
    for f in _codex_files():
        cwd, file_ts, file_events = _codex_scan_file(f)
        if cwd and file_ts:
            ts_groups[cwd].extend(file_ts)
            event_groups[cwd].extend(file_events)
    return [(cwd, sorted(ts), event_groups[cwd]) for cwd, ts in ts_groups.items()]


def codex_all():
    return [(label, ts) for label, ts, _ in codex_scan()]


def _codex_cwd_only(path):
    """Return just the session's cwd, reading only until the meta record.

    `list` doesn't need prompt timestamps, so avoid parsing the whole file:
    the `session_meta` record carrying `cwd` is at the top of the rollout.
    """
    try:
        with open(path, encoding="utf-8") as fh:
            for line in fh:
                line = line.strip()
                if not line:
                    continue
                try:
                    d = json.loads(line)
                except json.JSONDecodeError:
                    continue
                if d.get("type") == "session_meta":
                    return (d.get("payload") or {}).get("cwd")
    except OSError:
        return None
    return None


def codex_list():
    cwds = set()
    for f in _codex_files():
        cwd = _codex_cwd_only(f)
        if cwd:
            cwds.add(cwd)
    return sorted(cwds)


