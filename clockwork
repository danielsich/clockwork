        projects = PROVIDERS[provider]["scan"]()
    else:
        projects = [(label, ts, []) for label, ts in PROVIDERS[provider]["all"]()]

    rows = []
    all_events = []
    grand_minutes = 0.0
    grand_prompts = 0
    grand_sessions = 0

    for label, timestamps, events in projects:
        timestamps = _filter_timestamps(timestamps, since, until)
        if not timestamps:
            continue
        events = _filter_events(events, since, until)
        daily, sessions = compute_active_hours(timestamps, idle_threshold)
        total_minutes = sum(daily.values())
        rows.append({
            "label": label,
            "minutes": total_minutes,
            "prompts": len(timestamps),
            "sessions": len(sessions),
            "tokens": summarize_tokens(events) if show_tokens else None,
