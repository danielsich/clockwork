MODEL_TABLE_WIDTH = 80


def _day_keys(daily, token_days):
    """Every day either bucket knows about, in order.

    A response can complete after midnight, past the last prompt that defines
    the session's end — so a day can carry tokens without carrying active
    minutes. Taking the union keeps the per-day rows summing to the totals.
    """
    return sorted(set(daily) | set(token_days))


def _day_entry(day, daily, prompts_per_day, token_days, show_tokens):
    """One JSON day bucket, with tokens attached when they were collected."""
    entry = {"date": str(day),
             "minutes": round(daily[day], 2),
             "prompts": prompts_per_day[day]}
    if show_tokens:
        entry["tokens"] = token_days.get(day) or _sealed(_new_token_rec())
    return entry


def _print_token_lines(summary):
    """The three-line token block used under a run's summary header."""
    print(f"  Tokens  : {fmt_tokens(summary['total'])} across "
          f"{summary['responses']:,} responses")
    print(f"  In/Out  : {fmt_tokens(summary['input'])} in · "
          f"{fmt_tokens(summary['output'])} out")
    print(f"  Cache   : {fmt_tokens(summary['cache_read'])} read · "
          f"{fmt_tokens(summary['cache_write'])} write")
    if summary["reasoning"]:
        print(f"  Thinking: {fmt_tokens(summary['reasoning'])} "
              f"(Codex only; already counted inside output)")


def _print_model_table(summary):
    """Per-model token breakdown, biggest consumer first."""
    if not summary["by_model"]:
        return
    print(f"\n  {'MODEL':<20} {'RESP':>7} {'INPUT':>9} {'OUTPUT':>9} "
          f"{'CACHE R':>9} {'CACHE W':>9} {'TOTAL':>9}")
    print("-" * MODEL_TABLE_WIDTH)
    for m in summary["by_model"]:
        name = m["model"]
        if len(name) > 19:
            name = "…" + name[-18:]
        print(f"  {name:<20} {m['responses']:>7,} {fmt_tokens(m['input']):>9} "
              f"{fmt_tokens(m['output']):>9} {fmt_tokens(m['cache_read']):>9} "
              f"{fmt_tokens(m['cache_write']):>9} {fmt_tokens(m['total']):>9}")
    print("-" * MODEL_TABLE_WIDTH)
    print(f"  {'TOTAL':<20} {summary['responses']:>7,} "
          f"{fmt_tokens(summary['input']):>9} {fmt_tokens(summary['output']):>9} "
          f"{fmt_tokens(summary['cache_read']):>9} "
          f"{fmt_tokens(summary['cache_write']):>9} "
          f"{fmt_tokens(summary['total']):>9}")


def analyze_single(provider, project_path, idle_threshold, since, until, as_json,
                   show_tokens=False):
    if show_tokens:
        label, count, timestamps, events = PROVIDERS[provider]["scan_single"](project_path)
        events = _filter_events(events, since, until)
    else:
        label, count, timestamps = PROVIDERS[provider]["single"](project_path)
        events = []
    timestamps = _filter_timestamps(timestamps, since, until)

    if count == 0:
        if as_json:
            _print_json({
                "provider": provider, "project": project_path,
                "error": "no sessions found", "prompts": 0, "days": [],
            })
            sys.exit(1)
        print(f"❌ No {provider} sessions found for: {project_path}")
        projects = PROVIDERS[provider]["list"]()
        if projects:
            print(f"\n📁 Available {provider} projects ({PROVIDERS[provider]['location']}):")
            for p in projects:
                print(f"   {p}")
        sys.exit(1)

    if not timestamps:
        if as_json:
            _print_json({
                "provider": provider, "project": project_path, "label": label,
                "session_files": count, "since": _iso(since), "until": _iso(until),
                "prompts": 0, "days": [],
            })
            sys.exit(0)
        print("No user prompts found in the selected range.")
        sys.exit(0)

    daily, sessions = compute_active_hours(timestamps, idle_threshold)

    total_minutes = sum(daily.values())
    first_ts = timestamps[0]
    last_ts = timestamps[-1]
    span_days = (last_ts.date() - first_ts.date()).days + 1

    prompts_per_day = defaultdict(int)
    for ts in timestamps:
        prompts_per_day[ts.date()] += 1

    token_summary = summarize_tokens(events) if show_tokens else None
    token_days = tokens_by_day(events) if show_tokens else {}

    if as_json:
        payload = {
            "provider": provider,
            "project": project_path,
            "label": label,
            "session_files": count,
            "idle_threshold_min": idle_threshold,
            "since": _iso(since),
            "until": _iso(until),
            "first": _iso(first_ts),
            "last": _iso(last_ts),
            "span_days": span_days,
            "prompts": len(timestamps),
            "sessions": len(sessions),
            "active_days": len(daily),
            "total_minutes": round(total_minutes, 2),
            "days": [
                _day_entry(day, daily, prompts_per_day, token_days, show_tokens)
                for day in _day_keys(daily, token_days)
            ],
        }
        if show_tokens:
            payload["tokens"] = token_summary
        _print_json(payload)
        return

    print(f"✅ Found {count} session file(s) for: {label}\n")

    print("=" * 52)
    print(f"  CLOCKWORK — {_provider_label(provider)} SESSION ANALYSIS")
    print("=" * 52)
    print(f"  Project : {project_path}")
    print(f"  First   : {first_ts.strftime('%Y-%m-%d %H:%M')}")
    print(f"  Last    : {last_ts.strftime('%Y-%m-%d %H:%M')}")
    print(f"  Span    : {span_days} calendar days")
    print(f"  Prompts : {len(timestamps)} total")
    print(f"  Sessions: {len(sessions)} (idle threshold: {idle_threshold} min)")
    print(f"  Active  : {len(daily)} days")
    print(f"  Total   : {fmt_duration(total_minutes)}")
    if show_tokens:
        _print_token_lines(token_summary)
    print("=" * 52)

    token_col = f" {'TOKENS':>9}" if show_tokens else ""
    print(f"\n{'DATE':<14} {'ACTIVE TIME':<14} {'PROMPTS':<10}{token_col} BAR")
    print("-" * (52 + len(token_col)))

    max_mins = max(daily.values())
    for day in _day_keys(daily, token_days):
        mins = daily[day]
        bar_len = int((mins / max_mins) * 20) if max_mins else 0
        bar = "█" * bar_len
        cell = (f" {fmt_tokens(token_days.get(day, {}).get('total', 0)):>9}"
                if show_tokens else "")
        print(f"  {str(day):<12} {fmt_duration(mins):<14} "
              f"{prompts_per_day[day]:<10}{cell} {bar}")

    print("-" * (52 + len(token_col)))
    total_cell = f" {fmt_tokens(token_summary['total']):>9}" if show_tokens else ""
    # rstrip so the plain (no --tokens) row keeps its original width.
    print(f"  {'TOTAL':<12} {fmt_duration(total_minutes):<14} "
          f"{len(timestamps):<10}{total_cell}".rstrip())
    if show_tokens:
        _print_model_table(token_summary)
    print()


