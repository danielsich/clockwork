                     "prompts": r["prompts"],
                     "sessions": r["sessions"]}
            if show_tokens:
                entry["tokens"] = r["tokens"]
            projects_json.append(entry)
        totals = {
            "projects": len(rows),
            "minutes": round(grand_minutes, 2),
            "prompts": grand_prompts,
            "sessions": grand_sessions,
